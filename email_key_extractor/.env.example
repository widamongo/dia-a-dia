# Variables de entorno – copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env al repositorio

# ── Microsoft Graph / Outlook ─────────────────────────────────────────────────
# Obtén estos valores en Azure Portal → App Registrations → tu app
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your-client-secret-here

# Correo del usuario cuya bandeja se va a leer
GRAPH_USER_EMAIL=tu.correo@empresa.com

# Nombre exacto de la carpeta en Outlook (créala tú y agrega una regla de bandeja)
EMAIL_FOLDER_NAME=Claves-Automatizacion

# Máximo de correos a revisar por ejecución
EMAIL_MAX_MESSAGES=50

# ── Vault local cifrado ───────────────────────────────────────────────────────
# Contraseña maestra para cifrar/descifrar el vault local
# Usa una contraseña larga y aleatoria; guárdala en un gestor de contraseñas
LOCAL_VAULT_PASSWORD=cambia-esto-por-una-clave-segura

# Ruta del archivo vault cifrado (relativa al directorio de trabajo)
LOCAL_VAULT_PATH=vault.enc

# ── Azure Key Vault (opcional) ────────────────────────────────────────────────
# Si defines esta variable, se usará Azure Key Vault en lugar del vault local
# AZURE_VAULT_URL=https://mi-vault.vault.azure.net/

# ── Registro de evidencias ────────────────────────────────────────────────────
AUDIT_LOG_PATH=audit.log

# Días de vigencia de la clave en el vault (1 = expira al día siguiente)
KEY_TTL_DAYS=1
