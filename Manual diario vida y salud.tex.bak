Revisar el proceso diario de reaseguro para salud
El proceso de reaseguro consiste en garantizar que la informacion llegue a la tabla tgwb_reaseguros, esta llegan en esta 0 y cuando queda reasegurada el estado es 50, muchas veces se debe cambiar el estado a cero ya que la info queda en estado 3,4,10
Se valida diariamente que la info de la tabla historico llegue a la tabla trea_sini_movimientos

--RESERVA = 0, PAGOS = 1
/*
ESTADOS RESEGURO
0 = Estado iniciar para envio a reaseguro
3 = Pendiente de reenvio
4 = Error
10 = Enviado a reaseguro o en procesamiento
50 = Reasegurado
*/
--Consultar estado por transaccion de reserva o pago
SELECT r.cdestado_reaseguro,r.*,ROWID
FROM   tgwb_reaseguros r
WHERE  r.cdtipo_movimiento =1 -- (RESERVA = 0, PAGOS = 1)
AND    r.cdmovimiento_origen IN (124105607
);
--Consultar por dias
SELECT rr.cdestado_reaseguro,rr.*, rowid
FROM tgwb_reaseguros rr
WHERE rr.cdtipo_movimiento  in ('1', '0')-- (RESERVA = 0, PAGOS = 1)
  AND rr.cdestado_reaseguro < 50
  AND rr.Feingreso >= TO_DATE('2025-12-01', 'YYYY-MM-DD')
  AND rr.Feingreso < TO_DATE('2025-12-04', 'YYYY-MM-DD')
  ORDER BY cdtipo_movimiento;
  
--Contar por dias  
SELECT
  CASE rr.cdtipo_movimiento
    WHEN 0 THEN 'RESERVA'
    WHEN 1 THEN 'PAGO'
    ELSE 'DESCONOCIDO'
  END AS tipo_movimiento,
  COUNT(DISTINCT rr.cdmovimiento_origen) AS cantidad_movimientos
FROM tgwb_reaseguros rr
WHERE
  rr.cdtipo_movimiento IN (0, 1)
  AND rr.cdestado_reaseguro < 50
  AND rr.Feingreso >= TO_DATE('2025-12-01', 'YYYY-MM-DD')
  AND rr.Feingreso < TO_DATE('2025-12-04', 'YYYY-MM-DD')
GROUP BY rr.cdtipo_movimiento
ORDER BY rr.cdtipo_movimiento;
  
/*
ESTADOS RESEGURO
0 = Estado iniciar para envio a reaseguro
3 = Pendiente de reenvio
4 = Error
10 = Enviado a reaseguro o en procesamiento
50 = Reasegurado
*/

--Actualiza estado a cero para reenvio a reaseguro por dias
UPDATE tgwb_reaseguros rr
SET    rr.cdestado_reaseguro = 0
WHERE rr.cdtipo_movimiento in ('1', '0') -- (RESERVA = 0, PAGOS = 1)
  AND rr.cdestado_reaseguro < 50
  AND rr.Feingreso >= TO_DATE('2025-12-01', 'YYYY-MM-DD')
  AND rr.Feingreso < TO_DATE('2025-12-04', 'YYYY-MM-DD');
  

UPDATE tgwb_reaseguros rr
SET rr.cdestado_reaseguro = 0
WHERE rr.cdtipo_movimiento = 0
  AND rr.cdestado_reaseguro < 50
  --AND rr.Feingreso >= TO_DATE('2025-09-01', 'YYYY-MM-DD')
  --AND rr.Feingreso < TO_DATE('2025-09-010', 'YYYY-MM-DD')
  AND rr.cdmovimiento_origen NOT IN (193394027);


--Actualiza estado a cero para reenvio a reaseguro por transaccion
 
UPDATE tgwb_reaseguros rr
SET    rr.cdestado_reaseguro = 0
WHERE  rr.cdtipo_movimiento = 0 -- (RESERVA = 0, PAGOS = 1)
AND    rr.cdestado_reaseguro < 50
AND    rr.cdmovimiento_origen IN (193394027

)

SELECT inx.*, rea.*
FROM   tgwb_reaseguros rea
LEFT JOIN tgwb_inconsistencia inx
ON     inx.cdtipo = 'RAP' -- CODIGO PARA EL TIPO DE INCONSISTENCIAS DE REASEGURO (RAP=PAGOS, RAR=RESERVA)
AND    inx.cdclave = rea.cdmovimiento_origen
WHERE  rea.cdtipo_movimiento =1 -- reserva = 0, pago = 1
AND    rea.cdmovimiento_origen in (124206217


 -- COLOCAR LOS REGISTROS QUE INTERESAN
);

  


